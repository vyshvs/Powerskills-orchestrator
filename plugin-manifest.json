{
  "name": "powerskills-memory-orchestrator",
  "version": "2.0.1",
  "displayName": "PowerSkills Memory Orchestrator",
  "description": "Advanced plugin with global memory reader/writer sub-agent that records everything from start to end. Compatible with OpenAI, Claude, and Antigravity. Memory agent runs in parallel with ALL requests automatically.",
  "author": "PowerSkills Team",
  "license": "MIT",
  "platforms": {
    "openai": {
      "enabled": true,
      "apiVersion": "v1",
      "compatibleModels": ["gpt-4", "gpt-4-turbo", "gpt-3.5-turbo"]
    },
    "claude": {
      "enabled": true,
      "apiVersion": "v1",
      "compatibleModels": ["claude-opus-5", "claude-sonnet-5", "claude-haiku-4-5"]
    },
    "antigravity": {
      "enabled": true,
      "apiVersion": "v1",
      "compatibleModels": ["all"]
    }
  },
  "capabilities": {
    "memory": {
      "reader": true,
      "writer": true,
      "persistence": true,
      "streaming": true,
      "globalAgent": true,
      "alwaysActive": true
    },
    "subAgents": {
      "enabled": true,
      "maxConcurrent": 10,
      "isolation": "worktree",
      "globalAgents": ["memory-writer"]
    },
    "recording": {
      "sessionTracking": true,
      "eventLogging": true,
      "stateSnapshots": true,
      "parallelRecording": true
    }
  },
  "agents": [
    {
      "id": "memory-writer",
      "name": "Memory Writer",
      "type": "global",
      "scope": "all-requests",
      "model": "claude-haiku-4-5-20251001",
      "behavior": {
        "runInParallel": true,
        "alwaysActive": true,
        "nonBlocking": true,
        "mandatory": true
      },
      "description": "Manages persistent project memory — project structure tracking and implementation history. Uses Claude Haiku 4.5 exclusively.",
      "configPath": "agents/memory-writer.json",
      "documentationPath": "agents/memory-writer.md"
    }
  ],
  "policy": {
    "installation": "AVAILABLE",
    "authentication": "ON_INSTALL",
    "dataSharing": "NONE",
    "globalAgentsEnabled": true
  },
  "category": "Productivity"
}
